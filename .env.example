# Copy to .env and fill in. Every key is optional; sources without credentials are skipped.

# SEC asks every client to identify itself: "<name or project> <contact email>"
SEC_USER_AGENT="RiskEngine hackathon prototype your_email@example.com"

# Free API keys (optional)
FINNHUB_API_KEY=
NEWSAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LLM teacher: any OpenAI-compatible endpoint. Default: Groq free tier
# (console.groq.com -> API Keys). Free tier ~30 requests/min and a daily token cap;
# scripts/run_teacher.py batches items and resumes from cache across days.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MIN_INTERVAL_S=2.5
# Alternatives: local Ollama (LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen3:8b)

# Keep model caches off the system drive
HF_HOME=D:/riskengine-hackathon/.cache/hf
