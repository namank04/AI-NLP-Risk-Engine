# Copy to .env (gitignored). Everything is optional.

# SEC asks API clients to identify themselves
SEC_USER_AGENT="RiskEngine prototype your_email@example.com"

# LLM teacher (scripts/run_teacher.py): any OpenAI-compatible endpoint; Groq free tier by default
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss-120b free tier: ~8K tokens/min, so space batched requests
LLM_MIN_INTERVAL_S=40
